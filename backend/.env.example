# Google Gemini API Configuration (Optional)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# Server Configuration
PORT=8000
HOST=127.0.0.1

# Database & Authentication Configuration
DATABASE_URL=sqlite:///./retail_generator.db
MONGODB_URI=mongodb+srv://<db_user>:<password>@<cluster-host>/retail_generator?retryWrites=true&w=majority
MONGODB_DB_NAME=retail_generator
JWT_SECRET=copilot_retail_super_secure_jwt_secret_key_2026_at_least_32_bytes
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
