# Google Gemini API Configuration (Optional)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# Server Configuration
PORT=8000
HOST=127.0.0.1

# Database & Authentication Configuration
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@YOUR_CLUSTER.mongodb.net/?retryWrites=true&w=majority&appName=RetailProductStudio
MONGODB_DB_NAME=retail_generator
JWT_SECRET=replace_with_a_random_secret_at_least_32_bytes_long
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
